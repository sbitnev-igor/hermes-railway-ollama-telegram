
# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID; multiple IDs separated by commas
TELEGRAM_ALLOWED_USERS=

# API key from https://ollama.com/
OLLAMA_API_KEY=

# Ollama Cloud model ID
OLLAMA_MODEL=kimi-k2.5:cloud

# Persistent Hermes data directory
HERMES_HOME=/opt/data
